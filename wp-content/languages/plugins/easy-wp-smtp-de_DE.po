msgstr "Vollständiges Fehlerprotokoll anzeigen"

#: src/Admin/Pages/TestTab.php:1606
msgid "Copy Error Log"
msgstr "Fehlerprotokoll kopieren"

#: src/Admin/Pages/TestTab.php:1609
